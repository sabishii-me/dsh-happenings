{
  "name": "dsh-happenings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidebar calendar for AI-game / vibe-coding events: serves the packed site and runs its bundled Node/SQLite backend.",
  "license": "MIT",
  "author": "Sun Pengju",
  "engines": {
    "node": ">=22.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "client.js",
    "server.mjs",
    "lib",
    "data",
    "web",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
